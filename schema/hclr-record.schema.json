{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rootosophy/hclr/schema/hclr-record.schema.json",
  "title": "HCLR任务事件记录",
  "description": "HCLR（人类认知杠杆率）任务事件记录Schema。核心指标 HCLR=O/I：分子O=任务事件内模型输出Token（或字符）总和（含全部生成轮次），分母I=使用者介入Token（或字符）总和（不含初始任务描述）。C1/C2为结果状态记录（S0-S3），不进入公式。",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "domain",
    "model",
    "audience",
    "O0",
    "O1",
    "O_total",
    "interventions",
    "I",
    "I_metric",
    "C1",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "task_id": {
      "type": "string",
      "description": "任务唯一标识，如 hclr-20260812-001"
    },
    "title": {
      "type": "string",
      "description": "任务名称（可选）"
    },
    "domain": {
      "type": "string",
      "description": "任务领域，如 咨询/产品/编程/写作"
    },
    "model": {
      "type": "string",
      "description": "绑定模型及版本，如 deepseek-v4-flash / gpt-5.6"
    },
    "audience": {
      "type": "string",
      "description": "目标受众类型，如 部门领导/客户/同事/公开读者"
    },
    "task_description": {
      "type": "string",
      "description": "初始任务描述（不计入介入量I）"
    },
    "O0": {
      "type": "string",
      "description": "原始生成，冻结保存，不可覆盖"
    },
    "O1": {
      "type": "string",
      "description": "介入后最终成果"
    },
    "O_total": {
      "type": "number",
      "minimum": 0,
      "description": "任务事件内模型输出Token（或字符）总和，含全部生成轮次（分子O）"
    },
    "interventions": {
      "type": "array",
      "description": "使用者介入列表（针对模型输出的反馈/纠正/约束/方向调整，不含任务描述）",
      "items": {
        "type": "object",
        "required": [
          "seq",
          "text"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1,
            "description": "介入序号"
          },
          "text": {
            "type": "string",
            "description": "介入内容"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact_correction",
              "goal_adjustment",
              "constraint",
              "conclusion_revision",
              "framework_change",
              "style_adaptation",
              "other"
            ],
            "description": "介入类型"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "I": {
      "type": "number",
      "minimum": 0,
      "description": "介入量数值（分母I，不含任务描述）"
    },
    "I_metric": {
      "type": "string",
      "enum": [
        "chars",
        "tokens",
        "judgments"
      ],
      "description": "介入量口径：自动记录场景chars/tokens，人工记录场景judgments；同一曲线内不得混用"
    },
    "C1": {
      "type": "number",
      "enum": [
        0,
        0.5,
        1
      ],
      "description": "第一轮确认：1=已采纳，0.5=部分采纳（有少量修改），0=未采纳（结果状态记录，不进公式）"
    },
    "C2": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "第二轮确认：1=认可，0.5=部分认可，0-1间任意认可度（如0.25=25%采纳），null=待确认（结果状态记录，不进公式）"
    },
    "C2_note": {
      "type": "string",
      "description": "第二轮确认依据（真实受众反馈描述）"
    },
    "C2_source": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "user",
        "landing",
        "auto_timeout",
        "auto_confirm",
        null
      ],
      "description": "C2确认来源：user=使用者显式返回；landing=成果本地落地(保存/执行完成且未撤销)即视为100%认可；auto_timeout=发出确认请求后24h无响应默认认可；auto_confirm=主动再次确认后仍无响应采信默认认可"
    },
    "c2_requested_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "C2确认请求时间（结论性输出时记录，用于24h超时判断）"
    },
    "status": {
      "type": "string",
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ],
      "description": "结果状态：S0未采用 / S1已采用待确认 / S2已采用未获认可 / S3已采用并获认可"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "第一轮确认时间"
    },
    "c2_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "第二轮确认时间"
    },
    "c2_deadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "第二轮计划回访时间（可选）"
    },
    "period": {
      "type": "string",
      "description": "所属观察周期，如 2026-08"
    }
  }
}